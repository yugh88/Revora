# Copy to backend/.env and fill in. NEVER commit backend/.env (see .gitignore).

# SQLite file, persisted via the Docker volume declared in docker-compose.yml.
# Path is relative to the backend/ working directory.
DATABASE_URL=sqlite:///./revora.db

# Razorpay TEST-MODE keys only (free sandbox, Section 5).
# Used exclusively inside gateways/razorpay_test.py, and only when the user
# selects "Razorpay Test Sandbox" on the /batch or /events gateway toggle.
# The app runs fully without these: the default gateway is the built-in
# LocalSimulationGateway, which has zero external dependencies.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
