# Copy to backend/.env and fill in. NEVER commit backend/.env (see .gitignore).

# SQLite file, persisted via the Docker volume declared in docker-compose.yml.
# Path is relative to the backend/ working directory.
DATABASE_URL=sqlite:///./revora.db

# --------------------------------------------------------------------------- #
# Razorpay TEST-MODE keys only — the free official sandbox (Section 5)
# --------------------------------------------------------------------------- #
#
# OPTIONAL. Revora runs fully without them: the default gateway is the built-in
# LocalSimulationGateway, which has zero external dependencies, needs no
# credentials, and is the mode that must never fail during a demo. These keys
# are read only when the user selects "Razorpay Test Sandbox" on the gateway
# toggle, and are used only inside gateways/razorpay_test.py.
#
# Where to get them: Razorpay Dashboard -> Settings -> API Keys, with the
# dashboard in TEST mode. Generating test keys is free and creates no liability.
#
# TEST MODE IS ENFORCED, NOT ASSUMED. RazorpayTestGateway refuses to start
# unless RAZORPAY_KEY_ID begins with "rzp_test_". A live "rzp_live_" key is
# rejected at construction, because a live key reaching the execution path would
# move real money. If you see that error, you have pasted the wrong key.
#
# These are placeholders, not real credentials. Never commit real values, and
# never paste a secret into a log, a test, an issue, or a screen share.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
