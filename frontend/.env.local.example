# Copy to frontend/.env.local. Never commit a real .env.local.
#
# Base URL of the Revora FastAPI backend. NEXT_PUBLIC_ is required for the
# browser to read it, which also means anything here is PUBLIC — never put a
# secret in this file. The backend holds the Razorpay keys; the frontend never
# sees them.
#
# Local development (backend run with uvicorn on the host):
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Under docker-compose (a later session) the API is reachable from the browser
# on the published host port, not the internal service name.
